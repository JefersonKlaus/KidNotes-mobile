# Local development settings. Copy this file to `.env` (same folder):
#   Windows:       copy .env.example .env
#   macOS / Linux: cp .env.example .env
# `.env` is git-ignored and never packaged into the app (flet build).
# Variables already set in your terminal take priority over this file.

# Optional. Groq API key for "Reports" while developing, used when no key
# is saved in the app (the app's own setting is stored encrypted per account).
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Groq model for the reports (default: GROQ_MODEL in reports/ai.py).
# If Groq answers "model_not_found", the terminal lists the models your key
# can use. See https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional. Level of the app's logs in the terminal (DEBUG, INFO, WARNING...).
# Default INFO: e.g. each Groq call of "Generate reports" logs the URL, model,
# HTTP status and Groq's error message (never the key or the children's data).
# KIDNOTES_LOG_LEVEL=INFO
